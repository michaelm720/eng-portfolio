---
import ProjectCard from '@/components/ProjectCard.astro';
import { foundationProjects, projects } from '@/data/projects';
import '@/styles/global.css';

const title = 'Engineering Portfolio — Mechanical Design & Mechatronics';
const description = 'Selected engineering work across mechanical design, robotics, CAD, mechatronics, prototyping, and test.';
const socialImage = new URL('/og.png', Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111210" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Return to top">
        <span class="brand-mark">M<span>M</span></span>
        <span class="brand-type">Mechanical Design<br />+ Mechatronics</span>
      </a>

      <nav class="nav-tabs" aria-label="Primary navigation">
        <a href="#projects" data-section="projects" aria-current="page">Projects</a>
        <a href="#about" data-section="about">About</a>
        <a href="#resume" data-section="resume">Resume</a>
        <a href="#contact" data-section="contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-heading">
        <div class="hero-kicker">
          <span>Portfolio / 2026</span>
          <span>Front Range, Colorado</span>
        </div>
        <h1 id="hero-heading">Designing the<br />things between<br /><em>idea</em> and <em>impact.</em></h1>
        <div class="hero-footer">
          <p>
            Mechanical engineer and hands-on builder working across CAD, robotics,
            mechatronics, prototyping, and test.
          </p>
          <a href="#projects" class="text-link">View selected work <span>↓</span></a>
        </div>
        <div class="hero-blueprint" aria-hidden="true">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="core"></div>
          <span class="dimension dimension-a">Ø 143.0</span>
          <span class="dimension dimension-b">R 28.5</span>
          <span class="drawing-label">CONCEPT ASSEMBLY<br />REV 04 / SCALE 1:2</span>
        </div>
        <span class="scroll-marker">SCROLL TO INSPECT</span>
      </section>

      <section class="projects section-shell" id="projects" aria-labelledby="projects-heading">
        <div class="section-intro">
          <div>
            <span class="section-index">01 / Projects</span>
            <h2 id="projects-heading">Selected work</h2>
          </div>
          <p>
            {projects.length} projects. Some shipped, some failed, all taught me how physical
            systems behave outside the CAD viewport.
          </p>
        </div>

        <div class="project-list">
          {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
        </div>

        <aside class="project-foundations" aria-labelledby="foundations-heading">
          <span class="foundation-label" id="foundations-heading">Earlier engineering foundations</span>
          {foundationProjects.map((project) => (
            <article class="foundation-entry">
              <div>
                <span>{project.eyebrow}</span>
                <h3>{project.title}</h3>
              </div>
              <p>{project.summary}</p>
            </article>
          ))}
        </aside>
      </section>

      <section class="about section-shell" id="about" aria-labelledby="about-heading">
        <div class="section-intro">
          <div>
            <span class="section-index">02 / About</span>
            <h2 id="about-heading">I like the hard middle.</h2>
          </div>
          <p>
            The point where a clean concept meets imperfect materials, late design
            changes, limited machines, and a real deadline.
          </p>
        </div>

        <div class="about-grid">
          <p class="about-lead">
            I’m a mechanically minded engineer who reaches naturally for systems thinking.
            I enjoy taking incomplete requirements, turning them into geometry and testable
            assumptions, and staying with the work through fabrication and failure analysis.
          </p>
          <div class="principles">
            <article><span>01</span><h3>Model precisely.</h3><p>CAD is a decision-making tool, not just a rendering tool.</p></article>
            <article><span>02</span><h3>Build honestly.</h3><p>A rough prototype that reveals the truth is more valuable than a polished fiction.</p></article>
            <article><span>03</span><h3>Test the edge.</h3><p>Loads, tolerances, interfaces, and failure modes deserve attention early.</p></article>
          </div>
        </div>

        <div class="capability-marquee" aria-label="Core capabilities">
          <span>PARAMETRIC CAD</span><i></i><span>PROTOTYPING</span><i></i><span>MECHATRONICS</span><i></i><span>FEA</span><i></i><span>DESIGN FOR MANUFACTURE</span>
        </div>
      </section>

      <section class="resume section-shell" id="resume" aria-labelledby="resume-heading">
        <div class="section-intro">
          <div>
            <span class="section-index">03 / Resume</span>
            <h2 id="resume-heading">Experience in practice</h2>
          </div>
          <button class="print-button" type="button" data-print>Print / save as PDF ↗</button>
        </div>

        <div class="resume-grid">
          <section class="resume-history" aria-labelledby="experience-heading">
            <h3 id="experience-heading">Selected experience</h3>
            <ol class="resume-timeline">
              <li>
                <time datetime="2025-01">Jan 2025–present</time>
                <div>
                  <h4>Flight Test Lead — Stable Master</h4>
                  <span class="resume-employer">Skydio</span>
                  <p>Lead daily operations at Skydio’s Colorado test site and validate autonomous aircraft, docked systems, remote-operations workflows, and flight-control software under FAA BVLOS waivers, translating field findings into actionable feedback across hardware, software, and product teams.</p>
                </div>
              </li>
              <li>
                <time datetime="2024-07">Jul–Dec 2024</time>
                <div>
                  <h4>Flight Test Operator — Flight Core</h4>
                  <span class="resume-employer">Skydio</span>
                  <p>Supported high-altitude aircraft validation and early docked-system testing, reproducing field issues, verifying critical fixes, and helping the beta program reach release readiness.</p>
                </div>
              </li>
              <li>
                <time datetime="2022-09">Sep 2022–Jul 2024</time>
                <div>
                  <h4>Drone Pilot & Technician</h4>
                  <span class="resume-employer">CSU Drone Center</span>
                  <p>Operated multirotor, fixed-wing, and hybrid UAVs for research and client work, including airspace planning and infrared/GIS mapping for a 180-acre wildlife-conservation study.</p>
                </div>
              </li>
              <li>
                <time datetime="2023-05">May–Aug 2023</time>
                <div>
                  <h4>Engineering Design & 3D Printing Intern</h4>
                  <span class="resume-employer">Obermeyer Hydro</span>
                  <p>Used SolidWorks and FDM prototyping on a pump-turbine test program, redesigning a test stand to cut friction by 50% and identifying a manufacturing flaw before installation.</p>
                </div>
              </li>
            </ol>
          </section>

          <div class="resume-sidebar">
            <section class="resume-panel" aria-labelledby="education-heading">
              <h3 id="education-heading">Education</h3>
              <div class="education-entry">
                <span>2019–24</span>
                <h4>B.S. Mechanical Engineering</h4>
                <p>Colorado State University</p>
              </div>
              <div class="education-entry">
                <span>Spring 2021</span>
                <h4>International exchange</h4>
                <p>Swansea University, Wales</p>
              </div>
            </section>

            <section class="resume-panel" aria-labelledby="service-heading">
              <h3 id="service-heading">Early technical service</h3>
              <article class="service-entry">
                <time datetime="2018-03">Mar 2018–May 2019</time>
                <h4>Makerspace Youth Volunteer</h4>
                <span>Lafayette Public Library</span>
                <p>Joined during planning and launch, advised on equipment and software, prepared tools for public use, and taught Fusion 360, Tinkercad, Prusa 3D printing, Cricut cutting, and Carvey CNC routing.</p>
              </article>
              <article class="service-entry">
                <time datetime="2017-10">Oct 2017–Mar 2018</time>
                <h4>Middle School Robotics Club Peer Mentor</h4>
                <span>Angevine Middle School</span>
                <p>Helped develop course material and supported students learning LEGO NXT robot construction and programming.</p>
              </article>
            </section>

          </div>
        </div>

        <div class="resume-supporting">
          <section class="resume-panel" aria-labelledby="additional-heading">
            <h3 id="additional-heading">Additional experience</h3>
            <div class="additional-role">
              <span>2021–24</span>
              <p>Freelance Photographer<br /><em>Rocky Mountain Student Media</em></p>
            </div>
            <div class="additional-role">
              <span>2020–21</span>
              <p>Sales & Tech Consultant<br /><em>Colorado State University IT</em></p>
            </div>
          </section>

          <div class="resume-toolkit" aria-labelledby="toolkit-heading">
            <h3 id="toolkit-heading">Core toolkit</h3>
            <ul>
              <li>Flight test</li>
              <li>UAV operations</li>
              <li>SolidWorks</li>
              <li>FEA</li>
              <li>Rapid prototyping</li>
              <li>Test & data reduction</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="contact section-shell" id="contact" aria-labelledby="contact-heading">
        <span class="section-index">04 / Contact</span>
        <h2 id="contact-heading">Have a difficult<br />physical problem?</h2>
        <div class="contact-row">
          <p>I’d like to hear about it. Add your preferred email and professional links before launch.</p>
          <a class="contact-cta" href="mailto:hello@yourname.com">
            <span>Start a conversation</span>
            <span>↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <span>Engineering portfolio</span>
      <span>Designed for real project photography & CAD</span>
      <span>© <span data-year></span></span>
    </footer>

    <script>
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section]'));
      const sections = navLinks
        .map((link) => document.getElementById(link.dataset.section ?? ''))
        .filter((section): section is HTMLElement => Boolean(section));

      const setActive = (id: string) => {
        navLinks.forEach((link) => {
          if (link.dataset.section === id) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target.id) setActive(visible.target.id);
        },
        { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.15, 0.5] },
      );

      sections.forEach((section) => observer.observe(section));
      document.querySelector<HTMLElement>('[data-year]')!.textContent = String(new Date().getFullYear());
      document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => window.print());

      const projectCards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
      const projectSection = document.getElementById('projects');

      if (projectCards.length && projectSection) {
        document.documentElement.classList.add('project-accordion-ready');

        const setExpanded = (card: HTMLElement, expanded: boolean) => {
          const toggle = card.querySelector<HTMLButtonElement>('[data-project-toggle]');
          const label = card.querySelector<HTMLElement>('[data-toggle-label]');
          const reveal = card.querySelector<HTMLElement>('[data-project-reveal]');

          card.classList.toggle('is-expanded', expanded);
          toggle?.setAttribute('aria-expanded', String(expanded));
          reveal?.setAttribute('aria-hidden', String(!expanded));
          if (label) label.textContent = expanded ? 'Collapse project' : 'View project';
        };

        let activeCard: HTMLElement | null = null;
        let manualLock = false;
        let scrollExpansionEnabled = true;
        let animationFrame = 0;

        const activateCard = (nextCard: HTMLElement | null) => {
          if (activeCard === nextCard) return;
          projectCards.forEach((card) => setExpanded(card, card === nextCard));
          activeCard = nextCard;
        };

        projectCards.forEach((card) => {
          setExpanded(card, false);
          card.querySelector<HTMLButtonElement>('[data-project-toggle]')?.addEventListener('click', () => {
            const shouldExpand = !card.classList.contains('is-expanded');
            manualLock = true;
            scrollExpansionEnabled = shouldExpand;
            activateCard(shouldExpand ? card : null);
          });
        });

        const updateActiveProject = () => {
          animationFrame = 0;
          if (manualLock || !scrollExpansionEnabled) return;

          const sectionRect = projectSection.getBoundingClientRect();
          const readingLine = window.innerHeight * 0.46;

          if (sectionRect.top > window.innerHeight * 0.72 || sectionRect.bottom < window.innerHeight * 0.28) {
            activateCard(null);
            return;
          }

          const nearest = projectCards
            .map((card) => {
              const rect = card.getBoundingClientRect();
              const distance = readingLine < rect.top
                ? rect.top - readingLine
                : readingLine > rect.bottom
                  ? readingLine - rect.bottom
                  : 0;
              return { card, distance };
            })
            .sort((a, b) => a.distance - b.distance)[0];

          activateCard(nearest?.distance < window.innerHeight * 0.7 ? nearest.card : null);
        };

        const scheduleProjectUpdate = () => {
          if (!scrollExpansionEnabled) return;
          manualLock = false;
          if (!animationFrame) animationFrame = window.requestAnimationFrame(updateActiveProject);
        };

        window.addEventListener('scroll', scheduleProjectUpdate, { passive: true });
        window.addEventListener('resize', scheduleProjectUpdate);
        window.requestAnimationFrame(updateActiveProject);
      }

      const galleries = Array.from(document.querySelectorAll<HTMLElement>('[data-project-gallery]'));
      const reduceGalleryMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      galleries.forEach((gallery) => {
        const slides = Array.from(gallery.querySelectorAll<HTMLImageElement>('[data-gallery-slide]'));
        const segments = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-segment]'));
        const figureNumber = gallery.querySelector<HTMLElement>('[data-gallery-figure]');
        const figureCaption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
        const duration = 6000;
        let currentIndex = 0;
        let timeoutId = 0;
        let startedAt = 0;
        let remaining = duration;
        let isVisible = false;
        let isHovered = false;
        let hasFocus = false;

        const shouldPause = () =>
          reduceGalleryMotion.matches || document.hidden || !isVisible || isHovered || hasFocus;

        const clearGalleryTimer = () => {
          if (!timeoutId) return;
          window.clearTimeout(timeoutId);
          timeoutId = 0;
        };

        const syncGalleryPlayback = () => {
          const paused = shouldPause();
          gallery.classList.toggle('is-paused', paused);

          if (paused) {
            if (timeoutId) remaining = Math.max(0, remaining - (performance.now() - startedAt));
            clearGalleryTimer();
            return;
          }

          if (!timeoutId) {
            startedAt = performance.now();
            timeoutId = window.setTimeout(() => setGallerySlide((currentIndex + 1) % slides.length), remaining);
          }
        };

        const setGallerySlide = (nextIndex: number) => {
          clearGalleryTimer();
          currentIndex = nextIndex;
          remaining = duration;
          gallery.style.setProperty('--gallery-duration', `${duration}ms`);
          gallery.classList.remove('gallery-ready');

          slides.forEach((slide, slideIndex) => {
            const active = slideIndex === currentIndex;
            slide.classList.toggle('is-active', active);
            slide.setAttribute('aria-hidden', String(!active));
          });

          segments.forEach((segment, segmentIndex) => {
            segment.classList.toggle('is-complete', segmentIndex < currentIndex);
            segment.classList.toggle('is-active', segmentIndex === currentIndex);
            segment.setAttribute('aria-pressed', String(segmentIndex === currentIndex));
          });

          const activeSlide = slides[currentIndex];
          if (figureNumber && activeSlide.dataset.figureNumber) {
            figureNumber.textContent = activeSlide.dataset.figureNumber;
          }
          if (figureCaption && activeSlide.dataset.figureCaption) {
            figureCaption.textContent = activeSlide.dataset.figureCaption;
          }

          void gallery.offsetWidth;
          gallery.classList.add('gallery-ready');
          syncGalleryPlayback();
        };

        segments.forEach((segment, segmentIndex) => {
          segment.addEventListener('click', () => setGallerySlide(segmentIndex));
        });

        gallery.addEventListener('mouseenter', () => {
          isHovered = true;
          syncGalleryPlayback();
        });
        gallery.addEventListener('mouseleave', () => {
          isHovered = false;
          syncGalleryPlayback();
        });
        gallery.addEventListener('focusin', () => {
          hasFocus = true;
          syncGalleryPlayback();
        });
        gallery.addEventListener('focusout', () => {
          hasFocus = false;
          syncGalleryPlayback();
        });

        const galleryObserver = new IntersectionObserver(([entry]) => {
          isVisible = entry.isIntersecting && entry.intersectionRatio > .15;
          syncGalleryPlayback();
        }, { threshold: [0, .15, .5] });

        galleryObserver.observe(gallery);
        reduceGalleryMotion.addEventListener('change', syncGalleryPlayback);
        document.addEventListener('visibilitychange', syncGalleryPlayback);
        setGallerySlide(0);
      });
    </script>
  </body>
</html>

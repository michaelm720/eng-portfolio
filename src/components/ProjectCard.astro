---
import type { Project } from '@/data/projects';
import { StatusDot } from 'performative-ui';

interface Props {
  project: Project;
  figureStart: number;
}

const { project, figureStart } = Astro.props;
const projectImages = project.gallery?.length
  ? project.gallery
  : project.image
    ? [{ src: project.image, alt: project.imageAlt ?? '', label: project.imageCaption ?? 'Project image' }]
    : [];
const hasGallery = projectImages.length > 1;
const firstFigureNumber = String(figureStart).padStart(2, '0');
const firstFigureCaption = projectImages[0]?.label ?? project.imageCaption ?? 'Concept visualization';
const statusColor = project.status === 'On hold' ? 'var(--muted)' : 'var(--signal)';
const statusIsActive = project.status === 'In progress';
---

<article
  class:list={['project-card', { featured: project.featured }]}
  id={`project-${project.number}`}
  data-project-card
>
  <div class="project-summary-row">
    <div class="project-summary-heading">
      <div class="project-meta">
        <span>{project.number}</span>
        <span>{project.eyebrow}</span>
        <span class:list={['status', project.status.toLowerCase().replace(' ', '-')]}>
          <StatusDot color={statusColor} static={!statusIsActive} />
          {project.status}
        </span>
      </div>
      <div class="project-title-row">
        <h3 id={`project-title-${project.number}`}>{project.title}</h3>

        <button
          class="project-toggle"
          type="button"
          aria-expanded="true"
          aria-controls={`project-details-${project.number}`}
          aria-labelledby={`project-title-${project.number} project-toggle-label-${project.number}`}
          data-project-toggle
        >
          <span id={`project-toggle-label-${project.number}`} data-toggle-label>Collapse project</span>
          <i aria-hidden="true">↘</i>
        </button>
      </div>
    </div>
  </div>

  <div class="project-reveal" id={`project-details-${project.number}`} data-project-reveal>
    <div class="project-reveal-inner">
      <div
        class:list={['project-visual', { 'has-image': projectImages.length, 'has-gallery': hasGallery }]}
        data-visual={project.visual}
        data-project-gallery={hasGallery ? 'true' : undefined}
        aria-hidden={projectImages.length ? undefined : 'true'}
      >
        {projectImages.map((image, imageIndex) => (
          <img
            class:list={['project-image', { 'is-active': imageIndex === 0 }]}
            src={image.src}
            alt={image.alt}
            loading="lazy"
            decoding="async"
            data-gallery-slide={hasGallery ? '' : undefined}
            data-figure-number={hasGallery ? `FIG. ${String(figureStart + imageIndex).padStart(2, '0')}` : undefined}
            data-figure-caption={hasGallery ? image.label : undefined}
            aria-hidden={hasGallery ? String(imageIndex !== 0) : undefined}
          />
        ))}
        <div class="visual-grid"></div>
        {!projectImages.length && (
          <div class="visual-object">
            <span class="part part-a"></span>
            <span class="part part-b"></span>
            <span class="part part-c"></span>
            <span class="part part-d"></span>
          </div>
        )}
        <div class="visual-caption">
          <span data-gallery-figure>FIG. {firstFigureNumber}</span>
          <span data-gallery-caption>{firstFigureCaption}</span>
        </div>
        <div class="visual-scale"><i></i><i></i><i></i><i></i><i></i></div>
        {hasGallery && (
          <div
            class="gallery-progress"
            style={`--gallery-count: ${projectImages.length}`}
            aria-label={`Choose ${project.title} gallery image`}
          >
            {projectImages.map((image, imageIndex) => (
              <button
                class:list={['gallery-segment', { 'is-active': imageIndex === 0 }]}
                type="button"
                aria-label={`Show ${image.label}`}
                aria-pressed={imageIndex === 0 ? 'true' : 'false'}
                data-gallery-segment
              ></button>
            ))}
          </div>
        )}
      </div>

      <div class="project-expanded-copy">
        <p class="project-overview">{project.summary}</p>

        <div class="project-details">
          <div>
            <h4>My role</h4>
            <p>{project.contribution}</p>
          </div>
          <div>
            <h4>Result</h4>
            <p>{project.outcome}</p>
          </div>
        </div>

        <ul class="discipline-list" aria-label="Disciplines and tools">
          {project.disciplines.map((discipline) => <li>{discipline}</li>)}
        </ul>

        {project.url && (
          <a class="project-link" href={project.url} target="_blank" rel="noreferrer">
            {project.urlLabel ?? 'View live project'} <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
